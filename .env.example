# Copy this file to `.env` and adjust the values. Never commit the real `.env`.

# Application environment: development | staging | production
APP_ENV=development

# Host port the API is published on (container listens on this port too).
API_PORT=8000

# Async SQLAlchemy connection string. Host is the compose service name `db`
# (not localhost) when running via docker compose.
DATABASE_URL=postgresql+asyncpg://lensora:change-me@db:5432/lensora

# PostgreSQL credentials — consumed by the `db` service and referenced by DATABASE_URL.
POSTGRES_USER=lensora
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lensora

# Secret used for signing tokens. Generate a strong random value per environment.
SECRET_KEY=change-me

# JWT signing algorithm and access-token lifetime (minutes).
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=1440

# Organizations and their admin accounts are provisioned with:
#   python -m app.management.provision_organization --org-name ... --org-slug ... \
#       --admin-email ... --admin-password ... \
#       --admin-display-name-en ... --admin-display-name-ar ...
# There is no env-seeded account; every account is created by an explicit provisioning run.

# Comma-separated list of allowed CORS origins (the frontend dev server by default).
CORS_ORIGINS=http://localhost:5173

# Default lens-order deposit as a fraction of the order total (BRD §7.4; default 40%).
DEPOSIT_PERCENT=0.40

# AI provider configuration (assistant chat, styling advice, form extraction).
# AI_API_KEY is intentionally empty; the platform degrades gracefully to a
# deterministic fallback provider whenever it is unset or the service errors (NFR-4).
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-5
