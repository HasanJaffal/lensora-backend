# Copy this file to `.env` and adjust the values. Never commit the real `.env`.

# Application environment: development | staging | production
APP_ENV=development

# Host port the API is published on (container listens on this port too).
API_PORT=8000

# Async SQLAlchemy connection string. Host is the compose service name `db`
# (not localhost) when running via docker compose.
DATABASE_URL=postgresql+asyncpg://lensora:change-me@db:5432/lensora

# PostgreSQL credentials — consumed by the `db` service and referenced by DATABASE_URL.
POSTGRES_USER=lensora
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lensora

# Secret used for signing tokens. Generate a strong random value per environment.
SECRET_KEY=change-me

# JWT signing algorithm and access-token lifetime (minutes).
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=1440

# The single PLATFORM_ADMIN account — the only account seeded by the application. It is
# created on startup when both values below are set, and the environment stays the source of
# truth: a restart re-applies whatever is configured here, so this is also how the password is
# rotated. Leave either value blank to skip seeding entirely. The address must be a real,
# routable one — reserved TLDs such as .local and .test are rejected at startup, and an
# account created with one could never sign in.
PLATFORM_ADMIN_EMAIL=admin@lensora.example
PLATFORM_ADMIN_PASSWORD=change-me

# Bilingual display name for that account (optional; sensible defaults are applied).
PLATFORM_ADMIN_DISPLAY_NAME_EN=Platform Admin
PLATFORM_ADMIN_DISPLAY_NAME_AR=مسؤول المنصة

# No other data is seeded. Organizations and their ORGANIZATION_ADMIN accounts are created
# by the platform admin in-app (Organization Management), or from the command line with
# `python -m app.management.provision_organization` (see README.md).

# Comma-separated list of allowed CORS origins (the frontend dev server by default).
CORS_ORIGINS=http://localhost:5173

# The lens-order deposit percentage (BRD §7.4) is a per-organization setting passed to
# `provision_organization` (--deposit-percent), not an environment variable.

# Supabase Storage — backing store for patient documents, images, and reports.
# SUPABASE_URL is the project base URL (no trailing slash, no `/storage/v1` suffix).
SUPABASE_URL=

# Server-side only. The service role key bypasses row-level security, so it must never be
# exposed to the browser: the frontend uploads through short-lived signed URLs minted here.
SUPABASE_SERVICE_ROLE_KEY=

# Name of the (private) Supabase Storage bucket holding every organization's attachments.
SUPABASE_STORAGE_BUCKET=attachments

# Lifetime, in seconds, of the signed download URLs issued for viewing an attachment.
ATTACHMENT_SIGNED_URL_EXPIRES_SECONDS=3600
