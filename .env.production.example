# Production env template for the single-host deploy (docker-compose.prod.yml).
# Copy to `.env.production` on the server, fill in real values, then `chmod 600` it —
# PLATFORM_ADMIN_PASSWORD is re-applied from this file on every container restart.
# Never commit the real file.

APP_ENV=production

# uvicorn binds loopback only; nginx (deploy/nginx/lensora.conf) is the sole public entry point.
API_HOST=127.0.0.1
API_PORT=8300

# Host PostgreSQL (not the docker-compose.yml `db` service — that one is dev-only).
# scram-sha-256 auth on 127.0.0.1, per the server prep request.
DATABASE_URL=postgresql+asyncpg://lensora:<DB_PASSWORD>@127.0.0.1:5432/lensora
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Generate with: openssl rand -base64 48
SECRET_KEY=<GENERATE_ME>

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=1440

# Must be a real, routable address — reserved TLDs (.local, .test) are rejected at startup.
PLATFORM_ADMIN_EMAIL=<REAL_ADMIN_EMAIL>
PLATFORM_ADMIN_PASSWORD=<GENERATE_ME>
PLATFORM_ADMIN_DISPLAY_NAME_EN=Platform Admin
PLATFORM_ADMIN_DISPLAY_NAME_AR=مسؤول المنصة

# Same-origin deploy behind nginx: the SPA and API share one origin, so no cross-origin
# requests occur and this stays empty.
CORS_ORIGINS=

# Attachments are out of scope for this deploy; leave blank so the feature degrades to a
# typed 503 instead of failing at boot.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=attachments
ATTACHMENT_SIGNED_URL_EXPIRES_SECONDS=3600
